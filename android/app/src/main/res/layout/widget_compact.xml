<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:tint="@color/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp">

            <ImageView
                android:id="@+id/fire_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_fire_glow" />

            <ImageView
                android:id="@+id/fire_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_fire_active" />
        </FrameLayout>

        <TextView
            android:id="@+id/streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="0"
            android:textColor="@color/widget_hero"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/streak_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="week streak"
            android:textColor="@color/widget_text_dark"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/log_button"
            android:layout_width="120dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/log_button_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_button_bg"
                android:tint="@color/widget_hero" />

            <TextView
                android:id="@+id/log_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:maxLines="1"
                android:text="Log Workout"
                android:textColor="@color/widget_text_on_hero"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
